{
  "name": "y2k-new-tab-mcp",
  "version": "1.0.0",
  "description": "MCP server for Y2K New Tab Chrome extension - provides guestbook messages and Y2K facts.",
  "type": "module",
  "mcpName": "io.github.mrfentmen/y2k-new-tab-mcp",
  "repository": {
    "type": "git",
    "url": "https://github.com/mrfentmen/y2k-new-tab-mcp.git"
  },
  "bin": {
    "y2k-new-tab-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": ["dist"],
  "scripts": {
    "build": "/opt/homebrew/bin/tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "rm -rf dist && /opt/homebrew/bin/tsc -p tsconfig.json && node dist/index.js"
  },
  "keywords": ["mcp", "y2k", "chrome-extension", "new-tab"],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
